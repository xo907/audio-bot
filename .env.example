# ==========================================
# Discord Music Bot Configuration
# ==========================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# [REQUIRED] Your key (the same key as SaveX and GalleryX), from https://xo.st/keys/
# Leave blank to be asked for it the first time the bot starts.
LICENSE_KEY=

# [OPTIONAL] Command prefix for text commands (slash commands are enabled by default)
COMMAND_PREFIX=!

# [OPTIONAL] Default volume (1 to 150)
DEFAULT_VOLUME=100

# [OPTIONAL] Custom FFmpeg binary path (leave blank to auto-detect system/WinGet FFmpeg)
FFMPEG_PATH=

# [OPTIONAL] Default SponsorBlock categories to skip (comma-separated):
# Options: sponsor, selfpromo, interaction, intro, outro, music_offtopic, preview, filler
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction,intro,outro,music_offtopic

# [OPTIONAL] Enable SponsorBlock by default (true/false)
SPONSORBLOCK_ENABLED=true

# [OPTIONAL] Continuous similar-content autoplay radio by default (true/false)
AUTOPLAY_DEFAULT=true
AUTOPLAY_BATCH_SIZE=5

# [OPTIONAL] Clean chat: the bot's replies remove themselves after this many seconds (ones with buttons
# or menus after CLEAN_CHAT_MENU_DELAY), and typed !commands are removed at once. The player card stays.
CLEAN_CHAT=true
CLEAN_CHAT_DELAY=15
CLEAN_CHAT_MENU_DELAY=60

# [OPTIONAL] Inactivity timeout in seconds before the bot disconnects from voice (default: 180 = 3 minutes)
INACTIVITY_TIMEOUT=180
